# Copy to .env.seed and fill in, then run:  npm run seed
# .env.seed is gitignored - never commit real passwords.
#
# Emails: use ANY address you like - gmail, outlook, your own domain, whatever.
# The app does not restrict email domains. These are only placeholders.
# Passwords: minimum 8 characters.

SEED_ADMIN_EMAIL=you+admin@gmail.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=CLP Admin

SEED_INSTRUCTOR_EMAIL=you+instructor@gmail.com
SEED_INSTRUCTOR_PASSWORD=
SEED_INSTRUCTOR_NAME=CLP Instructor

SEED_LEARNER_EMAIL=you+learner@gmail.com
SEED_LEARNER_PASSWORD=
SEED_LEARNER_NAME=Test Learner
# single_course or all_access
SEED_LEARNER_ACCESS=all_access

# Optional: unlisted YouTube ID used for every demo lesson
SEED_DEMO_VIDEO_ID=
